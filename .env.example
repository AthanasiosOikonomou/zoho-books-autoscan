# ---- Zoho Books (SANDBOX first!) -------------------------------------------
BOOKS_DC=eu
BOOKS_ORG_ID=                      # sandbox organization_id (node scripts/books-probe.js orgs)
BOOKS_CLIENT_ID=                   # Self Client from https://api-console.zoho.eu
BOOKS_CLIENT_SECRET=
BOOKS_REFRESH_TOKEN=               # node scripts/books-token.js <grant_code>
BOOKS_RATE_PER_MIN=80
SEED_ALLOW_ORG_ID=                 # must equal BOOKS_ORG_ID for scripts/seed-sandbox.js to run

# ---- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=                 # key created inside the client's Console workspace
CLAUDE_MODEL=claude-haiku-5-5      # cheapest capable model; verify with: npm run claude-check
CLAUDE_FALLBACK_MODEL=             # leave empty (cost-first). e.g. a Sonnet id
CLAUDE_FALLBACK_BELOW_CONFIDENCE=0 # 0 = never
CLAUDE_PAGE_CAP=6

# ---- Matching --------------------------------------------------------------
TOTAL_TOLERANCE=0.02
CONFIDENCE_THRESHOLD=0.75
PO_PREFIX=PO-
PO_PAD_WIDTH=5
PO_LEGACY_PREFIXES=IPO/,IPO ,IPO-
MATCH_AGAINST_REMAINING=true
PHASE2_ENABLED=false

# ---- Run behaviour ---------------------------------------------------------
DRY_RUN=true                       # keep true until UAT sign-off
MAX_NEW_PER_RUN=40
MAX_RETRY_PER_RUN=20
CONCURRENCY=3
RETRY_AFTER_HOURS=12
MAX_ATTEMPTS=5
TIME_BUDGET_RATIO=0.7
LOCK_STALE_MINUTES=15

# ---- Report ----------------------------------------------------------------
REPORT_TO=                         # dev mailbox while testing; production: the finance inbox
REPORT_DEV_COPY=
REPORT_SUBJECT_PREFIX=AutoScan
MAIL_TRANSPORT=log                 # log (no email, report in the function log) | smtp (any mailbox + app password) | catalyst (domain verified in Catalyst Mail)
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=                         # the mailbox the report is sent from (Zoho Mail: use an app-specific password below)
SMTP_PASS=
REPORT_FROM=                       # smtp: leave empty (= SMTP_USER); catalyst: the verified sender

# ---- Catalyst CLI identity for this repo (local only, never deployed) ------
CATALYST_DC=eu
CATALYST_TOKEN=                    # catalyst login --force --dc eu (as the client-project user) → catalyst token:generate

# ---- Local only ------------------------------------------------------------
STATE_FILE=./.autoscan-state.json
OUT_DIR=./out
LOG_LEVEL=info
