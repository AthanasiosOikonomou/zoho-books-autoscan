# ---- Zoho Books (SANDBOX first!) -------------------------------------------
BOOKS_DC=eu
BOOKS_ORG_ID=                      # sandbox organization_id (node scripts/books-probe.js orgs)
BOOKS_CLIENT_ID=                   # Self Client from https://api-console.zoho.eu
BOOKS_CLIENT_SECRET=
BOOKS_REFRESH_TOKEN=               # node scripts/books-token.js <grant_code>
BOOKS_RATE_PER_MIN=80
SEED_ALLOW_ORG_ID=                 # must equal BOOKS_ORG_ID for scripts/seed-sandbox.js to run

# ---- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=                 # key from the Anthropic Console workspace that pays for the extraction
CLAUDE_MODEL=claude-haiku-5-5      # cheapest capable model; verify with: npm run claude-check
CLAUDE_FALLBACK_MODEL=             # leave empty (cost-first). e.g. a Sonnet id
CLAUDE_FALLBACK_BELOW_CONFIDENCE=0 # 0 = never
CLAUDE_PAGE_CAP=6
CLAUDE_MAX_OUTPUT_TOKENS=6000      # long invoices (16+ lines) need ~1,500; only the tokens actually produced are billed

# ---- Matching --------------------------------------------------------------
TOTAL_TOLERANCE=1.00               # GBP, on the invoice total
BILL_ADJUST_TO_INVOICE=true        # bill shows the supplier invoice total; the pence difference to the PO goes into the bill's adjustment
CONFIDENCE_THRESHOLD=0.75
PO_PREFIX=PO-                      # the Books PO numbering: PO-00235 → PO_PREFIX=PO-, PO_PAD_WIDTH=5 (PR-00123 → PR-, 5)
PO_PAD_WIDTH=5
PO_EXAMPLE=                        # optional: the Books PO shape shown to the model (default = prefix + padded number)
PO_LEGACY_PREFIXES=IPO/,IPO ,IPO-
MATCH_AGAINST_REMAINING=true
PHASE2_ENABLED=false               # true = line-level matching (Supplier Reference / MPN / SKU), partial bills at invoice prices, carriage per vendor rule
LINE_PRICE_TOLERANCE_PCT=5         # per line: invoice price BELOW the PO by up to this % → billed at the invoice price
LINE_PRICE_TOLERANCE_UP_PCT=0      # per line: allowed % ABOVE the PO price; 0 = any increase goes to review
LINE_PRICE_TOLERANCE_ABS=0.01      # GBP rounding guard in both directions
SUPPLIER_REF_LABEL=Supplier Reference   # item custom field printed on the PO lines
CARRIAGE_ITEM_ID=                  # carriage on a bill whose PO has no carriage line: the ONE carriage item of the organisation (sandbox: the seeded "Carriage" item), if there is one
CARRIAGE_ACCOUNT_ID=               # ...or, when carriage items are per supplier, the freight purchase account they all post to (npm run probe -- items carriage); both empty = first line's account
CARRIAGE_RULE_LABEL=Carriage Rule  # vendor custom fields (found by label — api names differ between sandbox and production)
CARRIAGE_TOLERANCE_LABEL=Carriage Tolerance
DEFAULT_CARRIAGE_RULE=Zero         # vendor with nothing set
CARRIAGE_BELOW_PO_OK=true          # carriage at or below the PO passes under every rule and is billed as invoiced (none invoiced → the PO carriage line stays open); the vendor rule decides only about carriage ABOVE the PO. false = two-way check as before
SURCHARGE_IN_PRICE=true            # a product surcharge row ("PRODUCT SURCHARGE 5%", "Order Surcharge") is part of the product price, not carriage. false = it counts as carriage
LINE_VALUE_FALLBACK=true           # an item without Supplier Reference / MPN is matched by value when exactly one open PO line fits. false = code match only

# ---- Run behaviour ---------------------------------------------------------
DRY_RUN=true                       # keep true until UAT sign-off
MAX_NEW_PER_RUN=40
SCAN_SINCE=                        # production: the go-live moment in UTC (e.g. 2025-01-31T09:00:00Z, or a date 2025-01-31 = midnight UTC); inbox documents created before it are never read, recorded or reported (the historical backlog stays untouched). Empty = all documents (sandbox)
MAX_RETRY_PER_RUN=20
CONCURRENCY=3
RETRY_AFTER_HOURS=6                # human-fixable exceptions (PO missing, total mismatch…) re-checked every 6 h — no AI call
RETRY_TRANSIENT_AFTER_MINUTES=0    # AI / Books / attach errors: 0 = retried on the next run
MAX_ATTEMPTS=28                    # × RETRY_AFTER_HOURS = one week of automatic reconciliation
TIME_BUDGET_RATIO=0.7
LOCK_STALE_MINUTES=15

# ---- Report ----------------------------------------------------------------
REPORT_TO=                         # dev mailbox while testing; production: the finance inbox
REPORT_DEV_COPY=
REPORT_SUBJECT_PREFIX=AutoScan
DAILY_REPORT_HOUR=17               # local hour (REPORT_TIMEZONE) after which the one-per-day digest is sent by the next run; off = never
REPORT_TIMEZONE=Europe/London
REPORT_PER_RUN=false               # true = also email the per-run report (default: per-run report in the log only)
MAIL_TRANSPORT=log                 # log (no email, report in the function log) | smtp (any mailbox + app password) | catalyst (domain verified in Catalyst Mail)
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=                         # the mailbox the report is sent from (Zoho Mail: use an app-specific password below)
SMTP_PASS=
REPORT_FROM=                       # smtp: leave empty (= SMTP_USER); catalyst: the verified sender

# ---- Production profile ----------------------------------------------------
# ONE .env, ONE deploy: the same variables go to both Catalyst environments. In the Development environment the
# function uses the plain variables above (the Books sandbox). In the Production environment it uses PROD_<NAME>
# when that is set and <NAME> otherwise — so anything not listed here (tolerances, labels, SMTP, Claude, the Books
# client) is shared, and any variable can be overridden for production by adding PROD_ in front of it.
# NEVER inherited from the sandbox set: BOOKS_ORG_ID, BOOKS_APP_BASE, DRY_RUN, SCAN_SINCE, CARRIAGE_ITEM_ID, CARRIAGE_ACCOUNT_ID.
PROD_BOOKS_ORG_ID=                 # required in Production: the production organization_id (must differ from BOOKS_ORG_ID)
PROD_SCAN_SINCE=                   # required in Production: the go-live moment in UTC (e.g. 2025-01-31T09:00:00Z) — nothing created before it is ever read
PROD_DRY_RUN=true                  # true (also when left empty) until UAT sign-off; false = bills are created in the production organisation
PROD_CARRIAGE_ITEM_ID=             # only if production has ONE carriage item for all suppliers
PROD_CARRIAGE_ACCOUNT_ID=          # production keeps a carriage item per supplier → the freight purchase account they share
PROD_PO_PREFIX=PO-                 # production PO numbering (e.g. PO-000482; bare legacy numbers are found as well)
PROD_PO_PAD_WIDTH=6
PROD_REPORT_TO=                    # production digest recipients; empty = REPORT_TO
PROD_REPORT_SUBJECT_PREFIX=        # e.g. "AutoScan" in production while REPORT_SUBJECT_PREFIX="AutoScan (sandbox)"

# ---- Catalyst CLI identity for this repo (local only, never deployed) ------
CATALYST_DC=eu
CATALYST_TOKEN=                    # catalyst login --force --dc eu (as the user invited to the target project) → catalyst token:generate

# ---- Local only ------------------------------------------------------------
STATE_FILE=./.autoscan-state.json
OUT_DIR=./out
LOG_LEVEL=info
